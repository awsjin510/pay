{
  "name": "pay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node etl/build.mjs",
    "data:fetch": "node etl/build.mjs --fetch",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "deploy": "npm run data:fetch && next build && wrangler deploy",
    "preview": "next build && wrangler dev",
    "review": "node scripts/review.mjs",
    "db:migrate": "wrangler d1 migrations apply pay-db --remote"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
